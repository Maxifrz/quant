__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Marktdaten und Ergebnisse werden nicht versioniert.
# Fuehrender Slash ist wichtig: 'data/' wuerde sonst auch src/qt/data/ treffen.
/data/
# Ausnahme: der Kontostand des Paper-Kontos. Er ist wenige Kilobyte JSON,
# enthaelt keine Geheimnisse -- und er ist das **einzige** im Datenverzeichnis,
# das sich nicht rekonstruieren laesst. Bars zieht ein Tick bei kaltem Store
# selbst nach (qt.live.runner), ein Konto kann das nicht: seine Geschichte ist
# weg, wenn die Datei weg ist. Ein Paper-Lauf ueber Wochen in einem Container,
# der taeglich neu gebaut wird, braucht deshalb genau diese Zeile.
!/data/paper/
/reports/
# Der LLM-Cache ist ausgenommen, sobald ein teurer Lauf drinsteckt: der
# Gate-Lauf kostet 145 Aufrufe und knapp vier Stunden, und der Cache macht ihn
# in jedem Container in Minuten reproduzierbar. Er ist zeitstempelfrei gebaut,
# liefert also bitgleiche Dateien, und enthaelt keine Geheimnisse -- die Keys
# sind Hashes, die Briefings sind blind (ADR-003). Aufgenommen wird er per
# `git add -f`, damit Zwischenstaende nicht versehentlich mitwandern.
/.llm_cache/

.env
.DS_Store
